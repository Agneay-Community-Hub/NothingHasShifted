  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>NOTICE</b>

    <size=70%>BY ORDER OF THE WARDEN</size>


    <align=left><size=80%>1.
    Do not ignore anything unusual in the corridor.


    2. If <b>anything has shifted</b>,
    turn back at once and take the stairs <b>behind you</b>.


    3. If <b>nothing
    has shifted</b>, walk on and take the stairs at the <b>far end</b>.


    4.
    Reach the <b>GROUND FLOOR</b> to leave.


    <i>Lights out 10:30 PM. Maintain
